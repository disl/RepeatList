<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.MainPage"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             >
    <ContentPage.BindingContext>
        <local:MainPageViewModel />
    </ContentPage.BindingContext>



    <!--<ContentPage.ToolbarItems>
        -->
    <!--<ToolbarItem  IconImageSource="kofi_symbol.png" Clicked="CoffeeButtonClicked" />-->
    <!--
        <ToolbarItem  StyleId="Item1" Order="Secondary" Text="{Binding Label_Export_list}" Command="{Binding Export_list_ClickedCommand}" />
        <ToolbarItem  StyleId="Item2" Order="Secondary" Text="{Binding Label_Reset_current_list}" Command="{Binding Reset_current_list_ClickedCommand}" />
    </ContentPage.ToolbarItems>-->
    <StackLayout Margin="20" VerticalOptions="FillAndExpand" Spacing="10" >

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <!-- LISTS -->
        <toolkit:Expander x:Name="expander" IsExpanded="{Binding IsExpander_listsExpended, Mode=TwoWay}"  >
            <toolkit:Expander.Header>
                <StackLayout Orientation="Horizontal">
                    <Label Text="{Binding Label_lists}" FontAttributes="Bold" FontSize="Medium" HorizontalOptions="Start" VerticalOptions="Center" 
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"  />
                    <Image Source="{Binding Expander_listsIcon}"   WidthRequest="40" HorizontalOptions="EndAndExpand" />
                </StackLayout>
            </toolkit:Expander.Header>
            <StackLayout Orientation="Vertical" >
                <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,15,0,0" HorizontalOptions="End">
                    <ImageButton Source="add_icon.png" Clicked="OnAddHeaderClicked"   
                            MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}"  />
                    <ImageButton Source="share_icon.png" Command="{Binding Export_list_ClickedCommand}" 
                            MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}" />
                </StackLayout>
                <Border  Stroke="Gray" StrokeThickness="1"  Padding="10"  >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                    <ListView x:Name="HeaderListView" ItemsSource="{Binding Headers}"   MaximumHeightRequest="200" InputTransparent="True"
                                      SelectedItem="{Binding Header_SelectedItem, Mode=OneWayToSource}" ItemSelected="OnHeaderSelected" SeparatorVisibility="None">
                        <ListView.ItemTemplate TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}">
                            <DataTemplate>
                                <ViewCell>
                                    <Grid Padding="7" ColumnDefinitions="5*,1.3*, 1.3*, 1.3*">
                                        <Label Text="{Binding ListName}"  VerticalOptions="Center"   Grid.Column="0" 
                                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"/>
                                        <ImageButton Source="edit_icon.png" Clicked="OnEditHeaderClicked" CommandParameter="{Binding}"  Grid.Column="1"/>
                                        <ImageButton Source="copy_icon.png" Clicked="OnCopyHeaderClicked" CommandParameter="{Binding}"  Grid.Column="2"/>
                                        <ImageButton Source="delete_icon.png" Clicked="OnDeleteHeaderClicked" CommandParameter="{Binding}"  Grid.Column="3"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackLayout>
        </toolkit:Expander>

        <!-- POSITIONEN -->
        <StackLayout Orientation="Horizontal"  Spacing="10">
            <Label Text="{Binding Label_Positions}" FontAttributes="Bold" FontSize="Medium" HorizontalOptions="StartAndExpand" Margin="0,10,0,0"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}" />
            <ImageButton Source="add_icon.png" Clicked="OnAddPositionClicked"   
                             MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}" HorizontalOptions="End" />
            <ImageButton Source="restart_icon.png" Clicked="OnResetPositionsClicked"
                             MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}"  HorizontalOptions="End"/>
        </StackLayout>

        <!-- Undone -->
        <Label Text="{Binding Label_undone}" FontAttributes="Bold"  HorizontalOptions="StartAndExpand" Margin="0" FontSize="Medium"
            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}" />
        <Border   Stroke="Gray" StrokeThickness="1"  Padding="10"  VerticalOptions="FillAndExpand" >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <CollectionView x:Name="PositionListView"  ItemsSource="{Binding Positions_undone}" SelectedItem="{Binding Position_selectedItem}"
                            MaximumHeightRequest="{Binding PositionsListHeight}" 
                            SelectionChanged="OnPositionSelected_new" ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="5*, 1.3*,1.3*,1.3*" VerticalOptions="Center" MaximumHeightRequest="50">
                            <Label Text="{Binding Title}" VerticalOptions="Center" Grid.Column="0" 
                                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"/>
                            <ImageButton Source="{Binding PositionImageSource}" Clicked="OnCheckedButtonClicked" CommandParameter="{Binding}" Grid.Column="1"/>
                            <ImageButton Source="edit_icon.png" Clicked="OnEditPositionClicked" CommandParameter="{Binding}" Grid.Column="2"/>
                            <ImageButton Source="delete_icon.png" Clicked="OnDeletePositionClicked" CommandParameter="{Binding}" Grid.Column="3"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Done -->
        <StackLayout Orientation="Horizontal" >
            <Label Text="{Binding Label_done}" FontAttributes="Bold"  HorizontalOptions="StartAndExpand" FontSize="Medium" VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}" />

            <!--<Label Text="{Binding Title_sort_by}"   HorizontalOptions="EndAndExpand"  VerticalOptions="End"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}" />-->
            <Picker x:Name="KindOfSortingPicker" Title="{Binding  Title_sort_by}"  HorizontalOptions="EndAndExpand" VerticalOptions="Center" Margin="0"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"
                    TitleColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"
                    SelectedIndexChanged="SortingPicker_SelectedIndexChanged"
                    SelectedItem="{Binding  SelectedItem_KindOfSorting, Mode=TwoWay}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="Name" />
                </Picker.ItemDisplayBinding>
            </Picker>
        </StackLayout>
        <HorizontalStackLayout>


        </HorizontalStackLayout>

        <Border   Stroke="Gray" StrokeThickness="1"  Padding="10"  VerticalOptions="FillAndExpand" >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <CollectionView x:Name="PositionDoneListView"  ItemsSource="{Binding Positions_done}" SelectedItem="{Binding Position_selectedItem}"
                MaximumHeightRequest="{Binding PositionsListHeight}" 
                SelectionChanged="OnPositionSelected_new" ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="5*, 1.3*,1.3*,1.3*" VerticalOptions="Center" MaximumHeightRequest="50">
                            <Label Text="{Binding Title}" VerticalOptions="Center" Grid.Column="0" 
                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"/>
                            <ImageButton Source="{Binding PositionImageSource}" Clicked="OnCheckedButtonClicked" CommandParameter="{Binding}" Grid.Column="1"/>
                            <ImageButton Source="edit_icon.png" Clicked="OnEditPositionClicked" CommandParameter="{Binding}" Grid.Column="2"/>
                            <ImageButton Source="delete_icon.png" Clicked="OnDeletePositionClicked" CommandParameter="{Binding}" Grid.Column="3"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Border>
    </StackLayout>
</ContentPage>
