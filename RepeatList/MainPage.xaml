<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.MainPage"
      
             >

    <StackLayout>
        <!-- Header List -->
        <ListView x:Name="HeaderListView" ItemSelected="OnHeaderSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding ListName}" Detail="{Binding Date, StringFormat='Date: {0:yyyy-MM-dd}'}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add Header -->
        <StackLayout Orientation="Horizontal"  Spacing="10" Margin="0,10,0,0" >
            <Entry x:Name="HeaderEntry" Placeholder="Enter a new list name" HorizontalOptions="FillAndExpand"/>
            <ImageButton Source="add_icon.png"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnAddHeaderClicked"
                         BackgroundColor="Transparent"
                         HorizontalOptions="End"/>
            <ImageButton Source="delete_icon.png"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnDeleteHeaderClicked"
                         BackgroundColor="Transparent" 
                         HorizontalOptions="End"/>
            <ImageButton Source="copy_icon.png"
                         HeightRequest="40"
                         WidthRequest="40"
                         Clicked="OnCopyHeaderClicked"
                         BackgroundColor="Transparent" 
                         HorizontalOptions="End"/>          
        </StackLayout>

        <!-- Positions for Selected Header -->
        <ListView x:Name="PositionListView"   ItemsSource="{Binding Positions}" ItemSelected="OnPositionSelected">
            <ListView.Header>
                <StackLayout>
                    <Label  Text="POSITIONEN" FontSize="Body" HorizontalOptions="Center"  Margin="10,0,0,0" />
                </StackLayout>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" ColumnDefinitions="*, Auto">
                            <Label Text="{Binding Title}" VerticalOptions="Center" Grid.Column="0"/>
                            <Switch IsToggled="{Binding IsCompleted, Mode=TwoWay}" 
                                    Toggled="OnPositionToggled"                                     
                                    Grid.Column="1"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add Position -->
        <StackLayout Orientation="Horizontal"  Spacing="10" Margin="0,10,0,0" >
            <Entry x:Name="PositionEntry" Placeholder="Enter a new task" HorizontalOptions="FillAndExpand" />
            <ImageButton Source="add_icon.png"
                 HeightRequest="40"
                 WidthRequest="40"
                 Clicked="OnAddPositionClicked"
                 BackgroundColor="Transparent"
                 HorizontalOptions="End"/>
            <ImageButton Source="delete_icon.png"
                 HeightRequest="40"
                 WidthRequest="40"
                 Clicked="OnDeletePositionClicked"
                 BackgroundColor="Transparent" 
                 HorizontalOptions="End"/>
        </StackLayout>
        <!--<Button Text="Add Position" Clicked="OnAddPositionClicked" />
        <Button Text="Delete Position" Clicked="OnDeletePositionClicked" />-->
    </StackLayout>

</ContentPage>
