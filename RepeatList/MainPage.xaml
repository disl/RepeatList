<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.MainPage"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             >

    <ContentPage.BindingContext>
        <local:MainPageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem  IconImageSource="kofi_symbol.png" Clicked="CoffeeButtonClicked" />
    </ContentPage.ToolbarItems>

    <!--<Grid Padding="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            -->
    <!--<RowDefinition Height="Auto" />-->
    <!--
            <RowDefinition Height="4*" />
            -->
    <!--<RowDefinition Height="Auto" />-->
    <!--
        </Grid.RowDefinitions>-->

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <!-- LISTS -->
            <toolkit:Expander ExpandedChanged="Expander_lists_ExpandedChanged" IsExpanded="{Binding IsExpander_listsExpended, Mode=TwoWay}" >
                <toolkit:Expander.Header >
                    <StackLayout Orientation="Horizontal">
                        <Label Text="LISTS" FontAttributes="Bold" FontSize="Medium" HorizontalOptions="Start" />
                        <Image Source="{Binding Expander_listsIcon}"  HeightRequest="40" WidthRequest="40" HorizontalOptions="EndAndExpand" />
                    </StackLayout>
                </toolkit:Expander.Header>
                <VerticalStackLayout >
                    <Button Text="Add new list" Clicked="OnAddHeaderClicked" TextColor="White"   HorizontalOptions="End" Margin="10"/>
                        <!-- LISTEN-ÜBERSICHT -->
                    <Border  Stroke="Gray" StrokeThickness="1"  Padding="10" Margin="5" >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <ListView x:Name="HeaderListView" ItemsSource="{Binding Headers}" SelectionMode="Single"   
                                      SelectedItem="{Binding Header_SelectedItem}" ItemSelected="OnHeaderSelected" SeparatorVisibility="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid Padding="7" ColumnDefinitions="5*,1*, 1*, 1*">
                                            <Label Text="{Binding ListName}"  VerticalOptions="Center"   Grid.Column="0"/>
                                            <ImageButton Source="edit_icon.png" Clicked="OnEditHeaderClicked" CommandParameter="{Binding}"  Grid.Column="1"/>
                                            <ImageButton Source="copy_icon.png" Clicked="OnCopyHeaderClicked" CommandParameter="{Binding}"  Grid.Column="2"/>
                                            <ImageButton Source="delete_icon.png" Clicked="OnDeleteHeaderClicked" CommandParameter="{Binding}"  Grid.Column="3"/>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </VerticalStackLayout>
            </toolkit:Expander>

            
            
            <!-- POSITIONS -->
            <!--<toolkit:Expander ExpandedChanged="Expander_positions_ExpandedChanged" IsExpanded="{Binding Expander_positionsExpended, Mode=TwoWay}">
                <toolkit:Expander.Header>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="POSITIONEN" FontAttributes="Bold" FontSize="Medium" />
                        <Image Source="{Binding Expander_positionsIcon}"  HeightRequest="40" WidthRequest="40" HorizontalOptions="EndAndExpand" />
                    </StackLayout>
                </toolkit:Expander.Header>
                <VerticalStackLayout Padding="10" >-->

            <StackLayout Orientation="Horizontal">
                <Label Text="POSITIONS" FontAttributes="Bold" FontSize="Medium" HorizontalOptions="Start" Margin="5,10,0,0" />
                <Button Text="Add new item" Clicked="OnAddPositionClicked" TextColor="White"   HorizontalOptions="EndAndExpand" Margin="0,5,10,5" />
            </StackLayout>
            <!-- POSITIONEN-ÜBERSICHT -->
                    <Border   Stroke="Gray" StrokeThickness="1"  Padding="10" Margin="5" >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <ListView x:Name="PositionListView" ItemsSource="{Binding Positions}" VerticalOptions="FillAndExpand"  
                            SelectedItem="{Binding Position_SelectedItem}"  ItemSelected="OnPositionSelected" SeparatorVisibility="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid Padding="10" ColumnDefinitions="4*, 2*,1.3*,1*">
                                            <Label Text="{Binding Title}" VerticalOptions="Center"  Grid.Column="0"/>
                                            <Switch IsToggled="{Binding IsCompleted, Mode=TwoWay}" Toggled="OnPositionToggled" Grid.Column="1"/>
                                            <ImageButton Source="edit_icon.png" Clicked="OnEditPositionClicked" CommandParameter="{Binding}"  Grid.Column="2"/>
                                            <ImageButton Source="delete_icon.png" Clicked="OnDeleteHeaderClicked" CommandParameter="{Binding}"  Grid.Column="3"/>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Border>

                    <!-- POSITIONEN-BUTTONS -->
                    <!--<StackLayout Orientation="Horizontal" Spacing="10" >
                        --><!--<ImageButton Source="close_icon.png" Clicked="OnClearPositionEntryClicked" HeightRequest="40" WidthRequest="40"/>--><!--
                        <Entry x:Name="PositionEntry" Placeholder="New item" HorizontalOptions="FillAndExpand"/>
                        <ImageButton Source="add_icon.png" Clicked="OnAddPositionClicked" HeightRequest="40" WidthRequest="40"/>
                        <ImageButton Source="delete_icon.png" Clicked="OnDeletePositionClicked" HeightRequest="40" WidthRequest="40"/>
                    </StackLayout>-->
                    <!--</StackLayout>-->

                <!--</VerticalStackLayout>
            </toolkit:Expander>-->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
