<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>RepeatList</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>RepeatList</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.repeatlist</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<PackageIcon>playstore_128.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Update="Resources\AppIcon\appicon.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Update="Resources\Splash\splashscreen.svg" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Remove="Platforms\MacCatalyst\**" />
		<AndroidResource Remove="Platforms\Tizen\**" />
		<AndroidResource Remove="Resources\AppIcon\Backup\**" />
		<AndroidResource Remove="Resources\Images\backup\**" />
		<AndroidResource Remove="Themes\**" />
		<Compile Remove="Platforms\MacCatalyst\**" />
		<Compile Remove="Platforms\Tizen\**" />
		<Compile Remove="Resources\AppIcon\Backup\**" />
		<Compile Remove="Resources\Images\backup\**" />
		<Compile Remove="Themes\**" />
		<EmbeddedResource Remove="Platforms\MacCatalyst\**" />
		<EmbeddedResource Remove="Platforms\Tizen\**" />
		<EmbeddedResource Remove="Resources\AppIcon\Backup\**" />
		<EmbeddedResource Remove="Resources\Images\backup\**" />
		<EmbeddedResource Remove="Themes\**" />
		<MauiCss Remove="Platforms\MacCatalyst\**" />
		<MauiCss Remove="Platforms\Tizen\**" />
		<MauiCss Remove="Resources\AppIcon\Backup\**" />
		<MauiCss Remove="Resources\Images\backup\**" />
		<MauiCss Remove="Themes\**" />
		<MauiImage Remove="Resources\Images\backup\**" />
		<MauiXaml Remove="Platforms\MacCatalyst\**" />
		<MauiXaml Remove="Platforms\Tizen\**" />
		<MauiXaml Remove="Resources\AppIcon\Backup\**" />
		<MauiXaml Remove="Resources\Images\backup\**" />
		<MauiXaml Remove="Themes\**" />
		<None Remove="Platforms\MacCatalyst\**" />
		<None Remove="Platforms\Tizen\**" />
		<None Remove="Resources\AppIcon\Backup\**" />
		<None Remove="Resources\Images\backup\**" />
		<None Remove="Themes\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Platforms\Android\Resources\values\todo.db3" />
		<None Remove="Platforms\Android\todo.db3" />
		<None Remove="Resources\AppIcon\appicon.svg" />
		<None Remove="Resources\Splash\splash - Kopie.svg" />
		<None Remove="Resources\Splash\splashscreen.svg" />
		<None Remove="Resources\Splash\splash_old.svg" />
		<None Remove="todo.db" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\todo.db3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="11.0.0" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.30" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.1" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
		<PackageReference Include="System.Private.Uri" Version="4.3.2" />
		<PackageReference Include="System.Reflection" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Platforms\Windows\App.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Services\" />
	</ItemGroup>

	<ItemGroup>
	  <MauiIcon Include="Resources\AppIcon\appicon.svg" />
	</ItemGroup>

	<ItemGroup>
		<MauiSplashScreen Include="Resources\Splash\splashscreen.svg" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\..\..\Downloads\AppIcons\playstore_128.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
