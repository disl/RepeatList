<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:RepeatList.Models"
    xmlns:properties="clr-namespace:RepeatList.Properties"
    x:Class="RepeatList.CategoryPosition_PopUp"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:String"
    BackgroundColor="LightGray"
    >
    
    <VerticalStackLayout Padding="10" BackgroundColor="LightGray">
        <Label Text="{x:Static properties:Resources.Select_a_category}" TextColor="Black" FontSize="Medium" HorizontalOptions="Center" />
        <Border Stroke="Gray" Padding="5" >
            <StackLayout Orientation="Vertical">
                <CollectionView  ItemsSource="{Binding Categories_colors_list}" 
                                 SelectionMode="Single"  
                                 BackgroundColor="LightGray"
                                 MaximumHeightRequest="300"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="auto,*" ColumnSpacing="10">
                                <toolkit:AvatarView Grid.Column="0" Text="" BackgroundColor="{Binding Color}"  />
                                <Label Text="{Binding Category}" VerticalOptions="Center" TextColor="Black" Grid.Column="1" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </Border>
        <Label Text="{x:Static properties:Resources.add}" FontSize="Medium" TextColor="Black" HorizontalOptions="Center" Margin="0,20,0,0"/>
        <Entry Text="{Binding SelectedCategory.Category, Mode=TwoWay}" TextColor="Black" ClearButtonVisibility="WhileEditing" />
        <HorizontalStackLayout HorizontalOptions="Center">
            <Button Text="OK" Clicked="OkButton_Clicked"  TextColor="White" WidthRequest="100" />
            <Button x:Name="CancelButton" 
                    BackgroundColor="{x:Static models:Constantes.Color_Warning}" Margin="10,0,0,0"  
                    Text="{x:Static properties:Resources.close}" TextColor="White" 
                    Clicked="CancelButtonClicked"    />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>