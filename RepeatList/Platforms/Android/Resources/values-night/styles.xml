<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark variant (values-night/): the status bar background is dark, so the system
        icons (clock, battery, ...) must stay WHITE (default). Explicitly cleared to make
        sure the light variant never leaks into dark mode.
    -->
    <style name="MiniListTheme" parent="@style/Maui.SplashTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
