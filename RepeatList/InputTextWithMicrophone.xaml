<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.InputTextWithMicrophone"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             Title="InputTextWithMicrophone"
             >

    <ContentPage.BindingContext>
        <local:InputTextWithMicrophoneViewModel/>
    </ContentPage.BindingContext>
    <Border BackgroundColor="Black" StrokeThickness="1" Stroke="LightGray" 
            Padding="20" Margin="20"    VerticalOptions="CenterAndExpand" 
        >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10" VerticalOptions="CenterAndExpand" >

                <Label Text="{Binding LabelText}" VerticalOptions="CenterAndExpand"  HorizontalOptions="FillAndExpand" />
                <Editor   Text="{Binding InputText}" AutoSize="TextChanges"  WidthRequest="300"     />
                <!--<ImageButton Clicked="OnMicrophone_Clicked" Source="microphone_icon.png" WidthRequest="50" HeightRequest="50" />-->

            <Button Text="OK" Clicked="OkButton_Clicked"  />
            <Button Text="{Binding Label_Cancel}" Clicked="OnCancel" BackgroundColor="Red" TextColor="White"/>
        </VerticalStackLayout>
    </Border>
</ContentPage>