<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.InputTextWithMicrophone"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             Title="InputTextWithMicrophone"
             >
    <ContentPage.BindingContext>
        <local:InputTextWithMicrophoneViewModel/>
    </ContentPage.BindingContext>
    <Border  StrokeThickness="1" Stroke="LightGray" 
            Padding="20" Margin="20,150,20,20"    VerticalOptions="StartAndExpand">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="20" VerticalOptions="StartAndExpand" >

            <Label Text="{Binding LabelText}" VerticalOptions="CenterAndExpand"  HorizontalOptions="FillAndExpand" />
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" >
                <Editor  Text="{Binding InputText, Mode=TwoWay }" AutoSize="TextChanges"   HorizontalOptions="FillAndExpand"  />
                <Button Text=",,"  Clicked="OnDoubleCommaButton_Clicked"    />
            </StackLayout>
            <!--<ImageButton Clicked="OnMicrophone_Clicked" Source="microphone_icon.png" WidthRequest="50" HeightRequest="50" />-->
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Spacing="20" >
                <Button Text="OK" Clicked="OkButton_Clicked" HorizontalOptions="FillAndExpand"  />
                <Button Text="{Binding Label_Cancel}" Clicked="OnCancel" BackgroundColor="Red"  TextColor="White" HorizontalOptions="FillAndExpand"/>
            </StackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>