<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.ListsPage"
             xmlns:models="clr-namespace:RepeatList.Models"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             xmlns:controls="clr-namespace:RepeatList.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"        
             Title="{Binding Title}" 
             >
    <!--xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"-->

    <!--<ContentPage.BindingContext>
        <local:ListsPageViewModel />
    </ContentPage.BindingContext>-->
    <ContentPage.ToolbarItems>
        <!--<ToolbarItem  IconImageSource="add_icon_white.png" Clicked="OnAddHeaderClicked" />-->
        <ToolbarItem  IconImageSource="kofi_symbol.png" Clicked="CoffeeButtonClicked" />
        <!--<ToolbarItem  StyleId="Item1" Order="Secondary"  IconImageSource="share_icon.png"  Text="{Binding Label_Export_list}" Command="{Binding Export_list_ClickedCommand}" />-->
        <!--<ToolbarItem  StyleId="Item2" Order="Secondary" Text="{Binding Label_Reset_current_list}" Command="{Binding Reset_current_list_ClickedCommand}" />-->
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="auto,auto,*" Margin="15,10,15,15">

        <!--<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Grid.Row="0" />-->

        <!--<controls:ActivityProgressBar IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Grid.Row="0" />-->

        <!--<StackLayout Orientation="Horizontal" Spacing="10" Margin="0,15,0,10" HorizontalOptions="End" Grid.Row="1">
            <ImageButton Source="add_icon.png" Clicked="OnAddHeaderClicked"   
                            MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}"  />
            -->
        <!--<ImageButton Source="upload_icon.png" Command="{Binding Export_list_ClickedCommand}" 
                            MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}" />-->
        <!--<ImageButton Source="sync_arrow_down_icon.png" Command="{Binding Import_listClickedCommand}" 
                            MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}" />-->
        <!--
        </StackLayout>-->

        <!--<BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="Fill" Grid.Row="2" Margin="0,0,0,10"/>-->

        <!--<SearchBar Placeholder="{Binding Search}" TextChanged="OnSearchTextChanged" Margin="0,0,0,10" Grid.Row="1" />-->

        <Grid ColumnDefinitions="auto,*,auto" Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="10">
            <Image Source="{AppThemeBinding Light=search_black.png, Dark=search_white.png}"  Grid.Column="0" />
            <Entry Grid.Column="1" Placeholder="{Binding Search}" HeightRequest="50"
                   TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"
                   PlaceholderColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                   TextChanged="OnSearchTextChanged" ClearButtonVisibility="WhileEditing" />
            <ImageButton Source="{AppThemeBinding Light=add_icon.png, Dark=add_icon_white.png}" 
                         Clicked="OnAddHeaderClicked" Grid.Column="2"
                         MaximumWidthRequest="{Binding ImageButton_size}" MaximumHeightRequest="{Binding ImageButton_size}" />
        </Grid>
        <Border Stroke="{AppThemeBinding Light=#00BCD4, Dark=#80DEEA}" StrokeThickness="1" Padding="5"  Grid.Row="2" >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <CollectionView x:Name="HeaderListView"  
                        ItemsSource="{Binding FilteredList}"                  
                        SelectionMode="Single" 
                        SelectedItem="{Binding Header_SelectedItem}" 
                        ItemSizingStrategy="MeasureAllItems"
                        SelectionChanged="OnHeaderListViewSelected" 
                       >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Black" StrokeThickness="0" Padding="3" >
                            <Grid ColumnDefinitions="auto,*,auto,auto" Padding="3" ColumnSpacing="10" >

                                <toolkit:AvatarView Grid.Column="0" HeightRequest="48" Text="{Binding AvatarName}" WidthRequest="48" BackgroundColor="Gray" TextColor="White"  />
                                <!--StackLayout>-->
                                <!--<ScrollView Orientation="Horizontal"   VerticalOptions="Center" >-->
                                <Label Text="{Binding ListName, FallbackValue = '?'}"  VerticalOptions="Center" FontSize="Medium"   Grid.Column="1" 
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextColor}, Dark={DynamicResource PrimaryTextColorLight}}"/>
                                <!--</ScrollView>-->
                                <Image Source="{Binding Sync_arrow_down_icon, FallbackValue = 'sync_arrow_down_icon_red.png'}" 
                                       IsVisible="{Binding IsSynchronized, FallbackValue = false}" HeightRequest="30" Grid.Column="2" />

                                <!-- Menu-Button -->
                                <ImageButton Grid.Column="3"   HeightRequest="30" WidthRequest="30" CommandParameter="{Binding .}">
                                    <ImageButton.GestureRecognizers >
                                        <TapGestureRecognizer Tapped="OnBurgerMenuTapped" NumberOfTapsRequired="1"  />
                                    </ImageButton.GestureRecognizers>
                                    <ImageButton.Source>
                                        <AppThemeBinding Light="more_vert_black.png"  Dark="more_vert_white.png" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <ContentView  HorizontalOptions="Center" VerticalOptions="Center" >
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Button Clicked="OnAddHeaderClicked" VerticalOptions="Center"
                                BackgroundColor="{x:Static models:Constantes.Color_Primary}"
                                Text="{Binding Please_create_a_first_list, FallbackValue = '?'}"  />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>

        </Border>
        <!-- AdMob -->
        <!--<Border Stroke="{AppThemeBinding Light=#00BCD4, Dark=#80DEEA}" StrokeThickness="1" Padding="5" Grid.Row="3" Margin="0,10,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <controls:AdBannerView HeightRequest="50" />
        </Border>-->

    </Grid>
</ContentPage>
