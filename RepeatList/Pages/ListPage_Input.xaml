<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RepeatList.ListPage_Input"
             xmlns:models="clr-namespace:RepeatList.Models"
             xmlns:local="clr-namespace:RepeatList.ViewModels"
             xmlns:controls="clr-namespace:RepeatList.Controls"
             xmlns:properties="clr-namespace:RepeatList.Properties" 
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:TypeArguments="system:Object"
             MaximumHeightRequest="550"
             BackgroundColor="Grey" >

    <ScrollView>
        <VerticalStackLayout Spacing="5"  >

            <!-- 1. New list name or Synchro-Code -->
            <Label Text="{x:Static properties:Resources.Enter_a_list_name_or_insert_a_ready_made}"
                   TextColor="{DynamicResource PrimaryTextColorLight}"
                   HorizontalOptions="Center"
                   FontSize="15"  />

            <Grid ColumnDefinitions="*,auto" ColumnSpacing="3" Margin="0,0,0,5" >

                <ScrollView MaximumHeightRequest="200" Grid.Column="0">
                    <Editor x:Name="ListNameEditor"
                    TextColor="{DynamicResource PrimaryTextColorLight}"
                    AutoSize="TextChanges" />
                </ScrollView>

                <Button Text="OK" Grid.Column="1" TextColor="White" Clicked="OnOkClicked" />
            </Grid>
            
            <!-- 2. Import list file -->
            <Label Text="{x:Static properties:Resources.Please_select_the_file_MiniList_Export_json}"  
                   TextColor="{DynamicResource PrimaryTextColorLight}"
                   HorizontalOptions="Center"
                   FontSize="15"  />
            <Button  Text="{x:Static properties:Resources.import_liste_file}" TextColor="White" Margin="0,0,0,20" 
                Clicked="OnListImport_Clicked"  CommandParameter="{Binding}"  />



            <!-- DeepSeek -->

            <!--<Label Text="{x:Static properties:Resources.What_would_you_like_to_create_a_chat_based_list_for}"  
                    TextColor="{DynamicResource PrimaryTextColorLight}"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
        FontSize="Medium"  />

            <Entry x:Name="DeepSeekEditor" 
                    TextColor="{DynamicResource PrimaryTextColorLight}"                                   
                    Completed="DeepSeekEditor_Completed"
                    />-->


            <!-- 3. KI-Listengenerierung (kostenpflichtig) -->
            <Border Stroke="#FF9800" StrokeThickness="1" Padding="8,8,8,3" Margin="0,5,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5" />
                </Border.StrokeShape>
            <VerticalStackLayout Spacing="3" IsVisible="True">
                <!-- Kopfzeile mit Icon und Text -->
                <Label Text="✨ KI-Listengenerierung"
                           TextColor="#FF9800"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="15"  />
                <Editor x:Name="DeepSeekEditor"
                        TextColor="{DynamicResource PrimaryTextColorLight}"
                        Placeholder="{x:Static properties:Resources.What_would_you_like_to_create_a_chat_based_list_for}"
                        PlaceholderColor="LightGray"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="72" />
                <Button x:Name="OnDeepSeekButton"
                        Text="OK"
                        HorizontalOptions="Center"
                        WidthRequest="120"
                        TextColor="White"
                        Clicked="OnDeepSeekClicked" />
                <Label x:Name="FreeStatusLabel"
                       Margin="0,2,0,0"
                       TextColor="#FF9800"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       FontSize="13"
                       Text="" />
                <Button x:Name="OnDeepSeek_SpotifyButton"
                        Text="{x:Static properties:Resources.Create_Spotify_playlist}"
                        TextColor="White"
                        IsVisible="False"
                        Clicked="OnDeepSeek_SpotifyClicked" />

                <!--<Button x:Name="OnPayPremiumButton" 
                        Text="{x:Static properties:Resources.Buy_Premium_Subscription}"  
                        BackgroundColor="{x:Static models:Constantes.Color_Warning}" 
                        Clicked="OnPayPremiumClicked" />-->

                <!-- Kaufoptionen -->
                <!--<Button x:Name="BuySubscriptionButton"
                        Text="Buy Premium (3.99 €/month)" 
                        Clicked="OnBuySubscription"
                        BackgroundColor="#2196F3"
                        TextColor="White" />-->

                <Button x:Name="BuyTokenPackButton"
                        Text="{x:Static properties:Resources.Buy_requests_099}" 
                        Clicked="OnBuyTokenPack"
                        BackgroundColor="#FF9800"
                        Margin="0,5,0,0"
                        TextColor="White" />

                <ActivityIndicator x:Name="Activity_Indicator" HeightRequest="30" Color="Crimson" />


                <!--<Button x:Name="RestorePurchasesButton"
                        Text="Restore Purchases" 
                        Clicked="OnRestorePurchases"
                        BackgroundColor="#9E9E9E"
                        TextColor="White" />-->

                <Label x:Name="StatusLabel"
                       Margin="0,4,0,0"
                       TextColor="LightGray"
                       HorizontalOptions="Center"
                       FontSize="12"
                       Text="" />

            </VerticalStackLayout>
            </Border>



            <!-- Cancel Button -->
            <!--<Button Text="{x:Static properties:Resources.Cancel}" Margin="0,20,0,0"  
                Grid.Column="1" 
                BackgroundColor="{x:Static models:Constantes.Color_Warning}" 
                Clicked="OnCancelClicked" />-->
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>