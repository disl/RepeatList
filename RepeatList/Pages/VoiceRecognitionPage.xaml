<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:RepeatList.Models"
    xmlns:properties="clr-namespace:RepeatList.Properties"
    x:Class="RepeatList.VoiceRecognitionPage"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:String"
   BackgroundColor="gray">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="{x:Static properties:Resources.Say_your_shopping_list}" FontSize="18" />
        <Editor x:Name="txtResult" HeightRequest="300" Placeholder="{x:Static properties:Resources.Your_text_appears_here}"  />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button x:Name="startButton" IsVisible="True" Text="🎤 START" Clicked="OnStartListeningClicked"   />
            <Button x:Name="stopButton" IsVisible="False" Text="⏹ STOP" Clicked="OnStopListeningClicked"  />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>
