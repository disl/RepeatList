<!--<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatList.SpeechRecognition"
             Title="SpeechRecognition">-->

<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:RepeatList.Models"
    xmlns:properties="clr-namespace:RepeatList.Properties"
    x:Class="RepeatList.SpeechRecognition"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:String"
    BackgroundColor="LightGray"
    MaximumHeightRequest="400"
    >
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="10">

            <!-- Eingabe -->
            <!--<Label Text="Sprach-Einkaufsliste" FontSize="24" HorizontalOptions="Center"/>

            <Entry x:Name="InputEntry" 
                   Placeholder="Oder manuell eingeben: Apfel; Banane; Brot"
                   Completed="OnAddManualItem"/>-->

            <!-- Aufnahme-Buttons -->
            <Grid ColumnDefinitions="*" ColumnSpacing="10">
                <Button x:Name="RecordButton" 
                        Text="🎤 Aufnahme starten" 
                        Clicked="OnRecordButtonClicked"
                        Grid.Column="0"/>

                <!--<Button x:Name="StopButton" 
                        Text="⏹️ Stoppen" 
                        Clicked="OnStopButtonClicked"
                        IsEnabled="False"
                        Grid.Column="1"/>-->
            </Grid>

            <Label x:Name="StatusLabel" 
                   Text="Bereit für Aufnahme" 
                   HorizontalOptions="Center"/>

            <!-- Ergebnis -->
            <Border BackgroundColor="#f0f8ff" 
                    Padding="15"
                    Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout>
                    <Label Text="Result:" FontAttributes="Bold"/>
                    <Label x:Name="ResultLabel" Text="{Binding FinalText }"/>
                </VerticalStackLayout>
            </Border>

            <!-- Aktionen -->
            <Button Text="Ok" 
                    Clicked="OnCopyListClicked"/>
            <Button Text="Cancel" 
                    Clicked="OnCancelClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>