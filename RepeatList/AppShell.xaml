<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RepeatList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RepeatList"
    xmlns:properties="clr-namespace:RepeatList.Properties"
    Shell.FlyoutBehavior="Flyout"
    
    xmlns:controls="clr-namespace:RepeatList.Controls"       
    Title="MiniList">
    <Shell.FlyoutHeader>
        <controls:FlyoutHeader />
    </Shell.FlyoutHeader>
    <!-- ResourcesViewModel wird NICHT mehr im XAML instanziiert: Der Konstruktor greift
         (über DatabaseService -> FileSystem.AppDataDirectory) auf MAUI-Essentials zu, die beim
         sehr frühen XAML-Load teils noch nicht bereit sind -> sporadische NullReferenceException.
         Stattdessen wird das BindingContext im Code-Behind (AppShell.OnAppearing) gesetzt. -->

    <ShellContent Title="MiniList"
                  ContentTemplate="{DataTemplate local:ListsPage}"  
                  Icon="{AppThemeBinding Light=home_black.png, Dark=home_white.png}"  
                  Route="Lists"  />
    <ShellContent x:Name="setupContetnt" 
                  Title="{Binding Setup}" 
                  Icon="{AppThemeBinding Light=settings_black.png, Dark=settings_white.png}"  
                  ContentTemplate="{DataTemplate local:SetupPage}"  
                  Route="SetupPage" />
    <!--<MenuItem Text="{OnPlatform x:TypeArguments=x:String, 
              Android='x:Static properties:Resources.Rate_app',
              iOS='Im App Store bewerten',
              Default='App bewerten'}" 
              Clicked="OnRateAppClicked" 
              IconImageSource="{AppThemeBinding Light=star_black.png, Dark=star_white.png}"  />-->

    <MenuItem Clicked="OnRateAppClicked" IconImageSource="{AppThemeBinding Light=star_black.png, Dark=star_white.png}">
        <MenuItem.Text>
            <OnPlatform x:TypeArguments="x:String">
                <On Platform="Android" Value="{x:Static properties:Resources.Rate_app_android}" />
                <On Platform="iOS" Value="{x:Static properties:Resources.Rate_app_ios}" />
                <On Platform="Default" Value="App bewerten" />
            </OnPlatform>
        </MenuItem.Text>
    </MenuItem>


    <!--x:Static properties:Resources.Rate_app}" 
              Clicked="OnRateAppClicked" 
              IconImageSource="{AppThemeBinding Light=star_black.png, Dark=star_white.png}"  />-->
    <MenuItem x:Name="DeviceIdButton"
              Text="Device-ID"     
              IconImageSource="{AppThemeBinding Light=numbers_black.png, Dark=numbers_white.png}"  
              Clicked="OnDeviceIDClicked" />

</Shell>

