<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RepeatList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RepeatList"
    Shell.FlyoutBehavior="Flyout"
    xmlns:controls="clr-namespace:RepeatList.Controls"
    Title="MiniList">
    <Shell.FlyoutHeader>
        <controls:FlyoutHeader />
    </Shell.FlyoutHeader>
    

    <ShellContent  Title="MiniList"  ContentTemplate="{DataTemplate local:Lists}"  Route="Lists" />
    <ShellContent  Title="Setup"  ContentTemplate="{DataTemplate local:SetupPage}"  Route="SetupPage" />

</Shell>
