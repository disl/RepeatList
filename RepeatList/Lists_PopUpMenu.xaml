<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:RepeatList.Models"
    xmlns:properties="clr-namespace:RepeatList.Properties"
    x:Class="RepeatList.Lists_PopUpMenu"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:String"
   BackgroundColor="gray"
    >
    
    <VerticalStackLayout Padding="10"  Spacing="10" BackgroundColor="gray">
        <Label Text="{x:Static properties:Resources.List_manipulation}"  FontSize="Medium" TextColor="White" />
        
        <Button  Text="{x:Static properties:Resources.edit}" TextColor="White"
                Clicked="OnEditHeaderClicked"  CommandParameter="{Binding}"  />
        <Button  Text="{x:Static properties:Resources.Delete_list}" TextColor="White" 
                Clicked="OnDeleteHeaderClicked"  CommandParameter="{Binding}" />
        
        <Label Text="{x:Static properties:Resources.Import_export_of_lists}"  FontSize="Medium" TextColor="White" />
        <Button  Text="{x:Static properties:Resources.Export_list}" TextColor="White" 
                Clicked="Export_list_Clicked"  CommandParameter="{Binding}"  />
        <Button  Text="{x:Static properties:Resources.import_liste}" TextColor="White" 
                Clicked="Import_list_Clicked"  CommandParameter="{Binding}"  />

        <Label x:Name="Synchronisation_of_listsLabel" Text="{x:Static properties:Resources.Synchronisation_of_lists}"  FontSize="Medium" TextColor="White" />
        <Button x:Name="Send_synchronisationButton" Text="{x:Static properties:Resources.Send_synchronisation}" TextColor="White" 
                Clicked="Sync_list_upClicked"  CommandParameter="{Binding}"   />
        <Button x:Name="Sync_removeButton"  Text="{x:Static properties:Resources.Delete_Synchronisation}"  
                BackgroundColor="{x:Static models:Constantes.Color_Warning}"
                TextColor="White" 
                Clicked="Sync_removeClicked"  CommandParameter="{Binding}"   />

        <Button x:Name="CancelButton" 
                BackgroundColor="{x:Static models:Constantes.Color_Warning}" Margin="0,10,0,0"  
                Text="{x:Static properties:Resources.close}" TextColor="White" 
                Clicked="CancelButtonClicked"    />

    </VerticalStackLayout>
</toolkit:Popup>